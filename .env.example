# GitHub token (classic or fine-grained with public_repo read)
GITHUB_TOKEN=

# OpenAI API key (for AI-assisted search)
OPENAI_API_KEY=
# Optional model override (default: gpt-4o-mini for the conversational agent, gpt-3.5-turbo for the CLI search command)
OPENAI_MODEL=

# Optional — if set, the conversational agent (npm run repo) prefers Claude over OpenAI
CLAUDE_API_KEY=
CLAUDE_MODEL=

# Database URL (used by Prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/repo_metrics

# Server port (default 3005)
PORT=3005

# Optional
NODE_ENV=development
